name: GitHub Metrics

on:
  schedule:
    - cron: "0 6 * * *"
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  github-metrics:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Generate GitHub Metrics
        uses: lowlighter/metrics@latest
        with:
          token: ${{ secrets.METRICS_TOKEN }}
          committer_token: ${{ secrets.GITHUB_TOKEN }}

          user: neerajsuthar
          filename: github-metrics.svg

          # ─────────────────────────────────────
          # Core profile
          # ─────────────────────────────────────
          base: header, activity, community, repositories, metadata

          # ─────────────────────────────────────
          # 🏆 Achievements
          # ─────────────────────────────────────
          plugin_achievements: yes
          plugin_achievements_display: compact
          plugin_achievements_threshold: C

          # ─────────────────────────────────────
          # 📅 Isometric contribution calendar
          # ─────────────────────────────────────
          plugin_isocalendar: yes
          plugin_isocalendar_duration: full-year

          # ─────────────────────────────────────
          # 🈷️ Programming languages
          # ─────────────────────────────────────
          plugin_languages: yes
          plugin_languages_limit: 6
          plugin_languages_details: percentage, bytes-size
          plugin_languages_sections: most-used, recently-used
          plugin_languages_other: yes

          # Don't let markup/config files dominate
          plugin_languages_ignored: >-
            HTML,
            CSS,
            SCSS,
            Less,
            TeX,
            Dockerfile,
            Makefile,
            Shell,
            CMake

          # ─────────────────────────────────────
          # 💡 Coding habits
          # ─────────────────────────────────────
          plugin_habits: yes
          plugin_habits_facts: yes
          plugin_habits_charts: yes
          plugin_habits_days: 30

          # ─────────────────────────────────────
          # 📰 Recent activity
          # ─────────────────────────────────────
          plugin_activity: yes
          plugin_activity_limit: 8
          plugin_activity_days: 30

          # ─────────────────────────────────────
          # 📆 Commit calendar
          # ─────────────────────────────────────
          plugin_calendar: yes

          # ─────────────────────────────────────
          # 🌟 Recently starred repositories
          # ─────────────────────────────────────
          plugin_stars: yes
          plugin_stars_limit: 5

          # ─────────────────────────────────────
          # 📌 Starred topics
          # ─────────────────────────────────────
          plugin_topics: yes
          plugin_topics_limit: 12

          # ─────────────────────────────────────
          # 🗳️ LeetCode
          # ─────────────────────────────────────
          plugin_leetcode: yes
          plugin_leetcode_user: neerajsuthar
          plugin_leetcode_sections: solved, skills

          # ─────────────────────────────────────
          # ⚙️ Rendering
          # ─────────────────────────────────────
          config_display: large
          optimize: yes
          plugins_errors_fatal: no
